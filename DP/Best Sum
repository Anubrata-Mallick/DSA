unordered_map<int, optional<vector<int>> > memo;

optional<vector<int>> bestSum(int targetSum, vector<int>& numbers){
    if(memo.count(targetSum)) return memo[targetSum];
    if(targetSum==0) return vector<int>{};
    if(targetSum<0) return nullopt;

    optional<vector<int>> shortestCombination = nullopt;

    for (int num : numbers)         
    {       
        int remainder = targetSum - num;
        auto combination = bestSum(remainder, numbers);

        if (combination)
        {
            combination->push_back(num);

            if (shortestCombination==nullopt || combination->size() < shortestCombination->size())
            {
                shortestCombination = combination;
            }
        }
    }

    // store the shortest combination 
    memo[targetSum] = shortestCombination;
    return shortestCombination;
}

int main()
{
    //FAST I/O
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);

    int t ; cin>>t;
    while(t--){
        int targetSum; cin>>targetSum;
        int sz; cin>>sz;
        vector<int> numbers(sz);
        for (int i = 0; i < sz; ++i)
        {
            cin>>numbers[i];
        }

        auto ans = bestSum(targetSum, numbers);
        if (ans)
        {
            cout<<"The shortest way to get "<<targetSum<<" is   [";

            for(int num : *ans){
                cout<<num<<" ";
            }
            cout<<"]"<<endl;
        }else{
            cout<<" can not be genarated " << endl;
        }

        memo.clear();
    }
}
