unordered_map<string, int> memo;

int countConstruct(string targetString, vector<string>& words){
    if(memo.count(targetString)) return memo[targetString];
    if(targetString=="") return 1;

    for(string word : words){
        if (targetString.find(word)==0) 
        {
            string suffix = targetString.substr(word.size());
            int ways = countConstruct(suffix, words);
            memo[targetString] += ways; 
        }
    }

    return memo[targetString];
}
int main()
{
