    while(t--){
        string target; cin>>target;
        int sz ; cin>>sz;
        vector<string> wordBank(sz);
        for (int i = 0; i < sz; ++i)
        {
            cin>>wordBank[i];
        } 
        cout<< target <<" can be constructed in "<<countConstruct(target, wordBank) << " ways" << endl;

        memo.clear();
    }
}
