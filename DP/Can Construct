unordered_map<string, bool> memo;

bool canConstruct(string targetString, vector<string>& words){
    if(memo.count(targetString)) return memo[targetString];
    if(targetString=="") return true;

    for(string word : words){
        if (targetString.find(word)==0) 
        {
            string suffix = targetString.substr(word.size());
            if(canConstruct(suffix, words)){
                return true;
            }
        }
    }

    memo[targetString] = false;
    return false;
}
int main()
{
    //FAST I/O
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);

    int t; cin>>t;
    while(t--){
        string target; cin>>target;
        int sz ; cin>>sz;
        vector<string> wordBank(sz);
        for (int i = 0; i < sz; ++i)
        {
            cin>>wordBank[i];
        }

        canConstruct(target, wordBank)?cout<<"Can be Construct"<<endl:cout<<"Can not be Constructed"<<endl;

        memo.clear();
    }
}
