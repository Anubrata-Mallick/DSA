unordered_map<int, bool> memo;

bool canSum(int targetSum, vector<int>& arr){

    if(memo.find(targetSum) != memo.end()) return memo[targetSum]; // look if present in memo
    if(targetSum==0) return true;
    if(targetSum<0) return false;

    for(int i=0; i<arr.size(); i++){ 
        int remainder = targetSum - arr[i];
        if(canSum(remainder, arr)){
            memo[targetSum]=true;
            return true;
        }
    }

    memo[targetSum]=false;
    return false;
}

int main()
{
    //FAST I/O
    ios_base::sync_with_stdio(false);
