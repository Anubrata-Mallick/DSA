    cout.tie(0);

    int targetSum;  cin>>targetSum;
    int n; cin>>n;
    vector<int> arr(n);
    for (int i = 0; i < n; ++i)
    {
        cin>>arr[i];
    }

    if (canSum(targetSum, arr)){
        cout<<"Can be nutralised";
    }else{
        cout<<"Can not be nutralised";
    }

    //clear the global store for new instances of test case
    memo.clear();
}
