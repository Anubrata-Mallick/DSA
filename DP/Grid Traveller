vector<vector<int>> memo;

int gridTraveler(int n, int m){
    if(memo[n][m]!=-1) return memo[n][m];
    if(n==1 && m==1) return 1;
    if(n==0 || m ==0) return 0;

    memo[n][m] = gridTraveler(n-1, m) + gridTraveler(n, m-1);
    return memo[n][m];
}

int main()
{
    //FAST I/O
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);

    int n,m ; cin>>n>>m;

    memo.resize(n+1, vector<int>(m+1, -1));

    int ans = gridTraveler(n, m);
    cout << "Possible ways = " << ans;
}
