struct SparseTable {
    vector<vector<long long>> st;
    vector<long long> lg;

    SparseTable(vector<long long>& a) {
        long long  n = a.size();

        lg.resize(n + 1);
        for (long long i = 2; i <= n; i++)
            lg[i] = lg[i / 2] + 1;

        long long K = lg[n] + 1;
        st.assign(K, vector<long long>(n));

        for (long long i = 0; i < n; i++)
            st[0][i] = a[i];

        for (long long k = 1; k < K; k++) {
            for (long long i = 0; i + (1 << k) <= n; i++) {
                st[k][i] = gcd(  //......................... ( MAX MIN GCD OR AND) DEFINING FUNCTION
                    st[k - 1][i],
                    st[k - 1][i + (1 << (k - 1))]
                );
            }
        }
    }

    long long query(long long l, long long r) {
        long long k = lg[r - l + 1];
        return gcd(st[k][l], st[k][r - (1 << k) + 1]); //......................... ( MAX MIN GCD OR AND) DEFINING FUNCTION
    }
};

int main()
{
    //FAST I/O
    ios_base::sync_with_stdio(false);
    cin.tie(0);
    cout.tie(0);

    long long n ; cin>>n;
    vector<long long> arr(n);
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }

    SparseTable st (arr);

    // code logic of main segment
    map<long long, long long> cnt;
    for(long long l=0; l<n; l++){
        long long pos = l; // all the elements before pos is processed
        while(pos<n){
            
            long long g = st.query(l, pos);
            // block size which have the same gcd 
            long long last = pos; long long lo = pos; long long hi = n-1;

            while(lo<=hi){
                long long mid = (lo+hi)/2;

                if(st.query(l, mid)==g){
                    last = mid;
                    lo = mid+1;
                }else{
                    hi = mid-1;
                }
            }

            cnt[g] += (last - pos)+1;
            pos = last + 1;
        }
    }

    // taking querry 
    long long q ; cin>>q;
    for(long long i =0; i<q; i++){
        long long a; cin>>a;
        cout<<cnt[a]<<endl;
    }
    
}
